# Database configuration for Interview Assistant Pro (MySQL)
# Copy to .env and adjust as needed. Port must remain 5000 to match scripts.

DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=5000
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123

# Connection pool settings (used by services that support pooling)
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30

# Derived/MySQL-specific (optional, for tools expecting MYSQL_* envs)
MYSQL_URL=mysql://localhost:5000/myapp
MYSQL_USER=appuser
MYSQL_PASSWORD=dbuser123
MYSQL_DB=myapp
MYSQL_PORT=5000
